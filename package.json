{
  "name": "schema-first-knowledge-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-First Node-Based Knowledge Graph System for Human-AI Orchestration",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "format": "nx run-many --target=format --all",
    "clean": "nx run-many --target=clean --all",
    "schema:validate": "echo \"Schema validation not implemented yet\" && exit 0",
    "schema:generate": "echo \"Schema generation not implemented yet\" && exit 0",
    "ci:local": "./bin/check.sh"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "@nx/eslint": "^18.0.5",
    "@nx/jest": "^18.0.5",
    "@nx/js": "^18.0.5",
    "@nx/next": "^18.0.5",
    "@nx/react": "^18.0.5",
    "@nx/workspace": "^18.0.5",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.6.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "json-schema-ref-parser": "^9.0.9",
    "lint-staged": "^15.2.0",
    "nx": "^18.0.5",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.8.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}