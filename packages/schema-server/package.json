    "js-yaml": "^4.1.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/cors": "^2.8.14",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.6.0",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/js-yaml": "^4.0.5",
    "jest": "^29.6.4",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "~5.8.0"
  }
} 