{
  "name": "@schema-first/schema-server",
  "version": "0.1.0",
  "description": "Schema server for the Schema-First Knowledge Graph system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
